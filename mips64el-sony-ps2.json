{
  "arch": "mips64",
  "cpu": "r5900",
  "vendor": "sony",
  "executables": true,
  "data-layout": "e-m:e-p:32:32-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128",
  "features": "+mips3,+single-float",
  "linker": "mips64r5900el-ps2-elf-gcc",
  "linker-flavor": "gcc",
  "llvm-target": "mips64el-none-elf",
  "llvm-abiname": "n32",
  "max-atomic-width": 64,
  "os": "none",
  "panic-strategy": "abort",
  "position-independent-executables": false,
  "relocation-model": "static",
  "relro-level": "off",
  "target-c-int-width": 32,
  "target-endian": "little",
  "target-pointer-width": 32,
  "pre-link-args": {
    "gcc": [
      "-EL",
      "-mabi=n32",
      "-mips3",
      "-Wl,-m,elf32lr5900n32"
    ]
  },
  "late-link-args": {
    "gcc": [
      "-nodefaultlibs",
      "-lgcc"
    ]
  }
}
